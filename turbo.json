{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "dist-electron/**"],
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_MC_URL",
        "VERCEL_URL",
        "APP_VERSION",
        "EXPO_PUBLIC_API_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "POSTGRES_PRISMA_URL",
        "POSTGRES_URL_NON_POOLING",
        "AUTH_SECRET",
        "REDIS_URL",
        "CRON_SECRET",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET_NAME",
        "R2_PREFIX",
        "VAPID_PUBLIC_KEY",
        "VAPID_PRIVATE_KEY",
        "VAPID_SUBJECT",
        "RESEND_API_KEY",
        "NOTIFICATION_FROM_EMAIL",
        "LICENSE_SERVER_URL",
        "LICENSE_REFRESH_TOKEN",
        "LICENSE_PUBLIC_KEY",
        "HETZNER_API_TOKEN",
        "HETZNER_SSH_KEY_ID",
        "DEPLOYMENT_WEBHOOK_BASE_URL",
        "SSH_KEY_ENCRYPTION_SECRET",
        "NEXT_PUBLIC_MC_URL",
        "VERCEL_URL",
        "APP_VERSION",
        "EXPO_PUBLIC_API_URL"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV", "POSTGRES_PRISMA_URL", "POSTGRES_URL_NON_POOLING", "AUTH_SECRET", "REDIS_URL"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "cache": false,
      "env": ["POSTGRES_PRISMA_URL", "POSTGRES_URL_NON_POOLING"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["POSTGRES_PRISMA_URL", "POSTGRES_URL_NON_POOLING"]
    },
    "db:migrate:deploy": {
      "cache": false,
      "env": ["POSTGRES_PRISMA_URL", "POSTGRES_URL_NON_POOLING"]
    }
  },
  "globalDependencies": [
    "tsconfig.json",
    ".prettierrc",
    ".eslintignore"
  ]
}

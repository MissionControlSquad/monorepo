{
  "name": "@agentcenter/mobile",
  "version": "0.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "start:android": "expo start --android",
    "start:ios": "expo start --ios",
    "start:web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo run:web",
    "build": "expo build",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "^52.0.0",
    "expo-router": "^3.5.0",
    "expo-secure-store": "^14.0.0",
    "react": "^18.3.0",
    "react-native": "^0.76.0",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "^4.2.0",
    "urql": "^5.0.0",
    "graphql": "^16.12.0",
    "zod": "^4.3.6",
    "@agentcenter/types": "*",
    "@agentcenter/utils": "*",
    "nativewind": "^2.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "^18.3.0",
    "babel-plugin-nativewind": "^1.0.0",
    "typescript": "~5.9.3",
    "prettier": "^3.8.1",
    "eslint": "^9.0.0",
    "jest": "^30.0.0",
    "@testing-library/react-native": "^14.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}

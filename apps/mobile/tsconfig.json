{
  "extends": "../../packages/config/ts/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@agentcenter/hooks": [
        "../../packages/hooks/src"
      ],
      "@agentcenter/types": [
        "../../packages/types/src"
      ],
      "@agentcenter/utils": [
        "../../packages/utils/src"
      ],
      "@agentcenter/config": [
        "../../packages/config"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".expo"
  ]
}
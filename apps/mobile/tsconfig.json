{
  "extends": "expo/tsconfig",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@agentcenter/types": ["../../packages/types/src"],
      "@agentcenter/utils": ["../../packages/utils/src"],
      "@agentcenter/config": ["../../packages/config/src"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}

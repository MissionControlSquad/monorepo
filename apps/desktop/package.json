{
  "name": "@agentcenter/desktop",
  "private": true,
  "version": "1.0.0",
  "description": "AgentCenter desktop application",
  "author": "AgentCenter <support@agentcenter.cloud>",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json && electron .",
    "build": "tsc -p tsconfig.json",
    "build:prod": "tsc -p tsconfig.prod.json",
    "package:mac": "npm run build:prod && electron-builder --mac --publish never && codesign --deep --force --sign - release/*/AgentCenter.app 2>/dev/null || true",
    "package:win": "npm run build:prod && electron-builder --win --publish never",
    "package:linux": "npm run build:prod && electron-builder --linux --publish never",
    "package:all": "npm run build:prod && electron-builder --mac --win --linux --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "electron-log": "^5.2.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.3"
  }
}

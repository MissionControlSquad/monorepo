{
  "name": "@agentcenter/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "npx dotenv -e .env.test -- vitest run",
    "test:unit": "vitest run tests/unit",
    "test:unit:no-db": "vitest run -c vitest.unit-no-db.config.ts",
    "test:e2e": "npx dotenv -e .env.test -- vitest run tests/e2e",
    "test:watch": "npx dotenv -e .env.test -- vitest",
    "seed:enterprise": "npx dotenv -e .env -- tsx scripts/seed-enterprise.ts",
    "seed:load-tasks": "npx dotenv -e .env -- tsx scripts/seed-load-tasks.ts",
    "check:notifications": "npx dotenv -e .env -- tsx scripts/check-notifications.ts",
    "backfill:profiles": "npx dotenv -e .env -- tsx scripts/backfill-profiles.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.986.0",
    "@aws-sdk/s3-request-presigner": "^3.986.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@agentcenter/database": "*",
    "@agentcenter/graphql-server": "*",
    "@agentcenter/graphql-client": "*",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-virtual": "^3.13.18",
    "@types/ssh2": "^1.15.5",
    "@urql/exchange-graphcache": "^9.0.0",
    "@urql/next": "^2.0.0",
    "autoprefixer": "^10.4.24",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "dotenv": "^17.3.1",
    "graphql": "^16.12.0",
    "graphql-sse": "^2.6.0",
    "highlight.js": "^11.11.1",
    "javascript-time-ago": "^2.6.2",
    "jose": "^6.1.3",
    "lucide-react": "^0.563.0",
    "marked": "^17.0.1",
    "next": "^15.3.3",
    "postcss": "^8.5.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^5.5.6",
    "react-hook-form": "^7.71.2",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "urql": "^5.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.3.6",
    "@agentcenter/types": "*",
    "@agentcenter/utils": "*"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --flag unstable_config_lookup_from_file"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@next/bundle-analyzer": "^16.1.6",
    "@next/eslint-plugin-next": "^16.1.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vercel": "^50.15.1",
    "vitest": "^4.0.18"
  }
}

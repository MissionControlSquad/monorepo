# ── AgentCenter Self-Hosted Configuration ───────────────────────
# Copy this file to .env and fill in the values.
# Required fields are marked with (required).

# ── Database (required) ─────────────────────────────────────────
# Password for the PostgreSQL database.
# Generate with: openssl rand -hex 16
PG_PASS=change-me-strong-password

# ── Redis (required) ──────────────────────────────────────────
# Password for Redis authentication.
# Generate with: openssl rand -hex 16
REDIS_PASS=change-me-redis-password

# ── Authentication (required) ───────────────────────────────────
# Random secret for signing session tokens. Must be at least 16 characters.
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Internal secret for cron jobs and license refresh calls.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Public URL (required) ──────────────────────────────────────
# The URL your users will access the app at.
# Examples: https://agents.yourcompany.com, http://localhost:3000
PUBLIC_URL=http://localhost:3000

# ── App Version ────────────────────────────────────────────────
# Docker image tag to use. Defaults to "latest".
APP_VERSION=latest

# ── Port ───────────────────────────────────────────────────────
# Host port to expose the app on. Defaults to 3000.
PORT=3000

# ── File Storage (optional) ────────────────────────────────────
# Cloudflare R2 credentials for file uploads and deliverables.
# If not set, file upload features will be disabled.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# ── Push Notifications (optional) ──────────────────────────────
# VAPID keys for web push notifications.
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourcompany.com

# ── Email Notifications (optional) ─────────────────────────────
# Resend API key for sending email notifications.
# Sign up at https://resend.com
# RESEND_API_KEY=
# NOTIFICATION_FROM_EMAIL=notifications@yourcompany.com

# ── buildbase tenancy (Epic #1) ────────────────────────────────
# Human identity/workspaces/roles/billing. Two ways to run it:
#   Cloud tier:  set SAAS_SERVER_URL=https://api.console.buildbase.app (no overlay needed).
#   Self-host:   run `docker compose -f docker-compose.yml -f docker-compose.buildbase.yml up -d`
#                (SAAS_SERVER_URL is set to the local tenant server by the overlay).
# From the buildbase dashboard: orgId (24-hex), client id/secret, and (self-host) an Installation.
# The app runs on the existing admin auth until SAAS_ORG_ID is set.
# SAAS_ORG_ID=
# SAAS_CLIENT_ID=
# SAAS_CLIENT_SECRET=
# SYSTEM_SECRET=            # random 32+ char secret used to sign the bb-workspace-token JWT
# SAAS_SERVER_URL=https://api.console.buildbase.app   # cloud tier only
#
# ── Workspace binding (one workspace per instance) ─────────────
# UNSET (default): any authenticated buildbase user signs in as OWNER of a single default workspace —
#   simplest for a solo/trusted self-host. SET to a workspace id: this instance is GATED to members of
#   THAT one workspace (real team RBAC — viewer/member/admin/owner), same as hosted; SYSTEM_SECRET
#   becomes load-bearing. Bind it with `npm run operator bind-workspace <workspace-id>` (or set here).
# Multiple workspaces = multiple self-host instances, each with its own TENANT_WORKSPACE_ID.
# TENANT_WORKSPACE_ID=
#
# Self-hosted buildbase stack (docker-compose.buildbase.yml) — from the Installation + starter:
# INSTALLATION_ID=
# INSTALLATION_API_KEY=
# JWT_PASS=
# DB_ENCRYPTION_KEY=
# SECRET_KEY=
# OAUTH2_SECRET=
# TENANT_SERVER_URL=http://localhost:4101   # browser-reachable tenant server URL
# CLIENT_URL=http://localhost:4100
# AUTH_URL=http://localhost:4103

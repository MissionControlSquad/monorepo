# ─── Database ───────────────────────────────────────────────
# Local PostgreSQL (127.0.0.1:5432, user: postgres, DB: clawd). Production: add ?sslmode=require and &pgbouncer=true on Prisma URL if using PgBouncer.
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@127.0.0.1:5432/clawd"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@127.0.0.1:5432/clawd"


# ─── Auth ──────────────────────────────────────────────────
# Secret for signing JWT sessions (min 16 chars, required in production)
AUTH_SECRET="generate-a-random-string-at-least-16-chars"

# ─── Cloudflare R2 Storage ─────────────────────────────────
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
# Bucket name (default: "mnc")
R2_BUCKET_NAME="mnc"

# ─── Cron ──────────────────────────────────────────────────
# Secret for authenticating cron job requests (auto-sleep endpoint)
CRON_SECRET="generate-a-random-string"

# ─── Push Notifications (optional) ────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Email Notifications via Resend (optional) ───────────
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=notifications@yourdomain.com

# ─── Optional ──────────────────────────────────────────────
# Local: NEXT_PUBLIC_MC_URL="http://localhost:3000"
# Production: NEXT_PUBLIC_MC_URL="https://your-domain.com"
# VERCEL_URL is set automatically by Vercel on deploy

# ─── Buildbase (user/human platform layer) ─────────────────
# All optional. When ORG_ID is empty the app runs on the existing admin auth
# (buildbase auth/workspaces/pricing/notifications stay dormant). See
# .paperclip-parity/BUILDBASE-PLAN.mdx for the AI-agent-vs-user-layer split.
NEXT_PUBLIC_SAAS_SERVER_URL=
NEXT_PUBLIC_SAAS_ORG_ID=
NEXT_PUBLIC_SAAS_CLIENT_ID=
NEXT_PUBLIC_APP_URL=
# Server-private signing secret for the /api/mcp scaffold (never NEXT_PUBLIC_).
# Same secret mintAgentToken uses; enables the MCP endpoint once set alongside ORG_ID.
BUILDBASE_MCP_SECRET=
# Server-to-server session for org-level buildbase calls (user-notification delivery adapter).
# When set (+ ORG_ID/SERVER_URL), push/email notifications route through buildbase notification.send;
# also stamp UserNotification.metadata.workspaceId at creation to opt a notification in. Else fallback.
BUILDBASE_SERVICE_SESSION_ID=

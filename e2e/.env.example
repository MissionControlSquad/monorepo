# Playwright e2e configuration. Copy to e2e/.env and fill in. Committed with NO values.
# Locally you normally only need ADMIN_PASSWORD (the app + DB you already run for dev is reused).

BASE_URL=http://localhost:3000
ADMIN_USER=admin
ADMIN_PASSWORD=

# Only needed when Playwright boots the app itself (CI, or no dev server running).
# In CI these point at the postgres/redis service containers.
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
REDIS_URL=

# Override the command Playwright uses to boot the web app (default: dev server for local reuse).
# In CI this is set to a production start after a build.
# PW_WEB_COMMAND=

# Playwright e2e configuration. Copy to e2e/.env and fill in. Committed with NO values.
#
# Auth is buildbase-only (no password login). The e2e auth setup bootstraps a session via the
# TEST-ONLY route POST /api/test/session, which requires the app to run with NODE_ENV=test AND a
# matching TEST_SESSION_SECRET. Set the SAME TEST_SESSION_SECRET here and in the app's test env.

BASE_URL=http://localhost:3000
ADMIN_USER=admin
# Shared secret for the test-only session bootstrap route (must match the served app's env).
TEST_SESSION_SECRET=

# Only needed when Playwright boots the app itself (CI, or no dev server running).
# In CI these point at the postgres/redis service containers.
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
REDIS_URL=

# Override the command Playwright uses to boot the web app (default: dev server for local reuse).
# In CI this is set to a production start after a build.
# PW_WEB_COMMAND=

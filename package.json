{
  "name": "agentcenter-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "e2e:debug": "playwright test --config=e2e/playwright.config.ts --debug",
    "e2e:headed": "playwright test --config=e2e/playwright.config.ts --headed",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:codegen": "playwright codegen http://localhost:3000",
    "db:generate": "turbo run db:generate --filter=@agentcenter/database",
    "db:migrate": "turbo run db:migrate --filter=@agentcenter/database",
    "db:migrate:deploy": "turbo run db:migrate:deploy --filter=@agentcenter/database",
    "doctor": "node scripts/doctor.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "turbo": "^2.5.0"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "expo-constants": "~18.0.13",
    "@urql/exchange-graphcache": {
      "@urql/core": "^6.0.3"
    }
  }
}

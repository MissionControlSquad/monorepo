// ─── Governance: Agent-domain Approvals & Trust (Epic #3) ─────────
// Human RBAC is buildbase (D1). This file models ONLY agent-domain governance,
// scoped by workspaceId (string, no FK — D5).

enum ApprovalStatus {
  pending
  approved
  rejected
  needs_changes
  cancelled
}

enum ApprovalSubjectType {
  task
  deliverable
  hire_agent
  budget_override
  agent_action // generic agent action gated by the approval-policy engine (run | tool_call | …)
}

enum TrustLevel {
  untrusted
  low
  standard
  trusted
}

model Approval {
  id                String              @id @default(cuid())
  workspaceId       String // buildbase workspace _id; no FK
  subjectType       ApprovalSubjectType
  subjectId         String // Task.id | Deliverable.id | agent-spec id (polymorphic, no FK)
  payload           Json? // subject-specific spec (e.g. hire_agent: {name, role, reportsToAgentId, level})
  taskId            String? // explicit approval↔task link
  status            ApprovalStatus      @default(pending)
  requiredApprovals Int                 @default(1) // Domain 14 #14 — N-of-M board quorum (1 = single decider)
  title             String
  reason            String?
  requestedById     String
  decidedById       String?
  decidedAt         DateTime?
  decisionNote      String?
  resubmitCount     Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  requestedBy Profile           @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy   Profile?          @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  task        Task?             @relation("ApprovalTask", fields: [taskId], references: [id], onDelete: SetNull)
  comments    ApprovalComment[]
  votes       ApprovalVote[]

  @@index([workspaceId, status])
  @@index([subjectType, subjectId])
  @@index([taskId])
  @@index([requestedById])
  @@index([status, createdAt])
  @@map("approvals")
}

// Domain 14 #14: a single board member's vote on an approval (for N-of-M quorum). One vote per voter.
model ApprovalVote {
  id             String   @id @default(cuid())
  approvalId     String
  voterProfileId String
  vote           String // approve | reject
  createdAt      DateTime @default(now())

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@unique([approvalId, voterProfileId])
  @@index([approvalId])
  @@map("approval_votes")
}

model ApprovalComment {
  id              String   @id @default(cuid())
  workspaceId     String // denormalized for isolation queries; no FK
  approvalId      String
  authorProfileId String
  body            String
  createdAt       DateTime @default(now())

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  author   Profile  @relation("ApprovalCommentAuthor", fields: [authorProfileId], references: [id], onDelete: Cascade)

  @@index([approvalId, createdAt])
  @@index([workspaceId])
  @@map("approval_comments")
}

model AgentTrustProfile {
  agentId                  String     @id // 1:1 with Agent
  workspaceId              String // no FK
  trustLevel               TrustLevel @default(standard)
  lowTrustContainment      Boolean    @default(false)
  requireUntrustedPrReview Boolean    @default(false)
  autoPromoteWorkProduct   Boolean    @default(true)
  sourceTrustBadge         String?
  changeConsentRequired    Boolean    @default(false)
  executionAllowlist       String[]   @default([])
  updatedAt                DateTime   @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, trustLevel])
  @@map("agent_trust_profiles")
}

// ─── Rule-based approval-policy engine (Domain 3 / governance depth) ─────
// Today agent approval is a coarse bool (`AgentGovernancePolicy.requireAgentApproval`) + trust flags.
// This adds a small declarative RULE engine: priority-ordered policies, first match wins, default allow.
// The pure evaluator lives in @agentcenter/utils (`evaluateApprovalPolicy`); this is its durable store.
// `subject` (which agents/roles a policy applies to) and `condition` (a JSON predicate, e.g.
// {costCentsOver:5000} / {trustBelow:"trusted"}) are JSON (app-validated). `effect` is TEXT
// (allow | require_approval | deny), not an enum, mirroring ToolAccessPolicy. workspaceId-scoped
// (D5; no FK). GOVERNANCE-gated.
model ApprovalPolicy {
  id          String   @id @default(cuid())
  workspaceId String // buildbase workspace _id; no FK (D5)
  name        String
  priority    Int      @default(0) // higher wins; ties broken deterministically by id
  subject     Json? // {all:true} | {agentIds:[...]} | {roles:[...]} | {trustLevels:[...]}; null/empty = all
  action      String // hire_agent | run | spend_over | tool_call | "*"
  condition   Json? // predicate, e.g. {costCentsOver:5000} | {trustBelow:"trusted"}; null = always
  effect      String   @default("require_approval") // allow | require_approval | deny
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, enabled])
  @@map("approval_policies")
}

// ─── Secrets Vault (Epic #5) ──────────────────────────────────────
// Workspace-scoped secret store with versioning + rotation, pluggable providers, bindings that
// inject secrets as env vars into agent/adapter runtimes, and an append-only access-event audit.
//
// Encryption at rest is REQUIRED: values are stored ONLY as AES-256-GCM ciphertext ("iv:authTag:ct",
// the exact envelope from services/ssh-keys.ts) under the SECRET_ENCRYPTION_KEY master key.
//
// Draft-spec rework: workspaceId (buildbase, D5 — no FK, indexed), NOT an Organization FK; gated by
// the buildbase feature `secrets_vault` (no retired License). providerId null = local envelope
// (the default) — external providers (aws/vault) are a deferred slice.

enum SecretProviderKind {
  env
  aws
  vault
}

enum SecretBindingScope {
  agent
  adapter
}

enum SecretAccessAction {
  created
  read
  rotated
  bound
  unbound
  revealed
  injected
}

model Secret {
  id             String   @id @default(cuid())
  workspaceId    String // buildbase workspace _id; no FK (D5)
  name           String // logical, e.g. "OPENAI_API_KEY"
  description    String?
  providerId     String? // null = local envelope-encrypted (default)
  currentVersion Int      @default(1)
  status         String   @default("active") // active | disabled | archived — only active resolves into agent env
  createdBy      String? // buildbase userId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider     SecretProviderConfig? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  versions     SecretVersion[]
  bindings     SecretBinding[]
  accessEvents SecretAccessEvent[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("secrets")
}

model SecretVersion {
  id         String    @id @default(cuid())
  secretId   String
  version    Int
  ciphertext String    @db.Text // "iv:authTag:ciphertext" — AES-256-GCM (ssh-keys.ts envelope)
  keyId      String    @default("env") // which master key wrapped this → supports key rotation
  createdBy  String?
  createdAt  DateTime  @default(now())
  retiredAt  DateTime?

  secret Secret @relation(fields: [secretId], references: [id], onDelete: Cascade)

  @@unique([secretId, version])
  @@index([secretId])
  @@map("secret_versions")
}

model SecretProviderConfig {
  id            String             @id @default(cuid())
  workspaceId   String
  kind          SecretProviderKind @default(env)
  name          String
  config        Json // non-secret settings (region, path prefix); its creds are themselves Secrets
  healthy       Boolean            @default(false)
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  secrets Secret[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("secret_provider_configs")
}

model SecretBinding {
  id            String             @id @default(cuid())
  secretId      String
  scope         SecretBindingScope
  agentId       String?
  adapterType   String?
  envVarName    String // exposed env var injected into the runtime
  pinnedVersion Int? // null = follow Secret.currentVersion
  createdBy     String?
  createdAt     DateTime           @default(now())

  secret  Secret        @relation(fields: [secretId], references: [id], onDelete: Cascade)
  agent   Agent?        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  adapter AgentAdapter? @relation(fields: [adapterType], references: [type], onDelete: Cascade)

  @@unique([agentId, envVarName])
  @@index([secretId])
  @@index([agentId])
  @@index([adapterType])
  @@map("secret_bindings")
}

model SecretAccessEvent {
  id        String             @id @default(cuid())
  secretId  String
  action    SecretAccessAction
  actorType String // "user" | "agent" | "system"
  actorId   String?
  agentId   String?
  version   Int?
  metadata  Json?
  createdAt DateTime           @default(now())

  secret Secret @relation(fields: [secretId], references: [id], onDelete: Cascade)

  @@index([secretId, createdAt])
  @@index([agentId])
  @@map("secret_access_events")
}

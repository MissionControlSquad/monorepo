// ─── Secrets Vault (Epic #5) ──────────────────────────────────────
// Workspace-scoped secret store with versioning + rotation, pluggable providers, bindings that
// inject secrets as env vars into agent/adapter runtimes, and an append-only access-event audit.
//
// Encryption at rest is REQUIRED: values are stored ONLY as AES-256-GCM ciphertext ("iv:authTag:ct",
// the exact envelope from services/ssh-keys.ts) under the SECRET_ENCRYPTION_KEY master key.
//
// Draft-spec rework: workspaceId (buildbase, D5 — no FK, indexed), NOT an Organization FK; gated by
// the buildbase feature `secrets_vault` (no retired License). providerId null = local envelope
// (the default) — external providers (aws/vault) are a deferred slice.

enum SecretProviderKind {
  env
  aws
  vault
}

enum SecretBindingScope {
  agent
  adapter
}

enum SecretAccessAction {
  created
  read
  rotated
  bound
  unbound
  revealed
  injected
}

// Fulfilment state of a per-user secret declaration (parity §3 #7).
enum UserSecretDeclarationStatus {
  provided
  missing
}

model Secret {
  id             String   @id @default(cuid())
  workspaceId    String // buildbase workspace _id; no FK (D5)
  name           String // logical, e.g. "OPENAI_API_KEY"
  description    String?
  providerId     String? // null = local envelope-encrypted (default)
  currentVersion Int      @default(1)
  status         String   @default("active") // active | disabled | archived — only active resolves into agent env
  personal       Boolean  @default(false) // true = a member's private secret (owner-only), not a workspace secret
  createdBy      String? // buildbase userId — the OWNER when personal=true
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider     SecretProviderConfig? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  versions     SecretVersion[]
  bindings     SecretBinding[]
  accessEvents SecretAccessEvent[]
  // A personal Secret can back a per-user secret declaration (parity §3 #7). SetNull keeps the
  // declaration row (as "missing") if the underlying secret is deleted.
  userSecretDeclarations UserSecretDeclaration[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("secrets")
}

model SecretVersion {
  id         String    @id @default(cuid())
  secretId   String
  version    Int
  ciphertext String    @db.Text // "iv:authTag:ciphertext" — AES-256-GCM (ssh-keys.ts envelope)
  keyId      String    @default("env") // which master key wrapped this → supports key rotation
  createdBy  String?
  createdAt  DateTime  @default(now())
  retiredAt  DateTime?

  secret Secret @relation(fields: [secretId], references: [id], onDelete: Cascade)

  @@unique([secretId, version])
  @@index([secretId])
  @@map("secret_versions")
}

model SecretProviderConfig {
  id            String             @id @default(cuid())
  workspaceId   String
  kind          SecretProviderKind @default(env)
  name          String
  config        Json // non-secret settings (region, path prefix); its creds are themselves Secrets
  healthy       Boolean            @default(false)
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  secrets Secret[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("secret_provider_configs")
}

model SecretBinding {
  id            String             @id @default(cuid())
  secretId      String
  scope         SecretBindingScope
  agentId       String?
  adapterType   String?
  envVarName    String // exposed env var injected into the runtime
  pinnedVersion Int? // null = follow Secret.currentVersion
  createdBy     String?
  createdAt     DateTime           @default(now())

  secret  Secret        @relation(fields: [secretId], references: [id], onDelete: Cascade)
  agent   Agent?        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  adapter AgentAdapter? @relation(fields: [adapterType], references: [type], onDelete: Cascade)

  @@unique([agentId, envVarName])
  @@index([secretId])
  @@index([agentId])
  @@index([adapterType])
  @@map("secret_bindings")
}

// Human-approved secret proposals (port of Paperclip #9934). An agent (or the system) PROPOSES a
// secret it needs; the row stays INERT and separate from the live `secrets` table until an admin
// approves it. Approval materializes the real vault Secret through the existing createSecret path and
// records the link via `createdSecretId`. No plaintext secret is ever stored here — `placeholderValue`
// is only a non-secret hint; the admin supplies the real value at approval time. Follows the Secret
// model's FK style: workspaceId is a buildbase id (no FK, D5); requestedByAgentId / decidedByProfileId
// are plain string ids (no FK) so a proposal never cascades from live tables.
model SecretProposal {
  id                 String    @id @default(cuid())
  workspaceId        String // buildbase workspace _id; no FK (D5)
  name               String // proposed secret key/name, e.g. "OPENAI_API_KEY"
  description        String? // purpose — why the agent needs this credential
  scope              String    @default("workspace") // requested binding scope: "workspace" | "agent"
  requestedByAgentId String? // the agent that proposed it (null = system-authored)
  placeholderValue   String? // optional NON-secret hint (format/example); the real value is entered on approval
  status             String    @default("pending") // pending | approved | denied
  decisionReason     String? // required on deny; optional note on approve
  decidedByProfileId String? // the admin who approved/denied (buildbase userId — the profile id)
  createdSecretId    String? // the real vault Secret produced on approval
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  decidedAt          DateTime?

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("secret_proposals")
}

model SecretAccessEvent {
  id           String             @id @default(cuid())
  secretId     String
  action       SecretAccessAction
  actorType    String // "user" | "agent" | "system"
  actorId      String?
  agentId      String?
  version      Int?
  // Audit-on-resolve provenance (Domain 7 P1): what consumed the secret, where, and the outcome.
  consumerType String? // "agent" | "adapter" | "environment" | "system"
  consumerId   String? // the concrete consumer id (agentId, environmentId, …)
  configPath   String? // dotted target, e.g. "env.OPENAI_API_KEY"
  outcome      String? // success | failure | missing | not_allowed | provider_error
  errorCode    String?
  runId        String? // the AgentRun this resolution served (run injection)
  metadata     Json?
  createdAt    DateTime           @default(now())

  secret Secret @relation(fields: [secretId], references: [id], onDelete: Cascade)

  @@index([secretId, createdAt])
  @@index([agentId])
  @@index([runId])
  @@map("secret_access_events")
}

// ─── User-scoped secret definitions + declarations (parity §3 #7) ──────────────────────────
// A DEFINITION is workspace-level: "this workspace expects each member to provide credential X"
// (e.g. GITHUB_TOKEN). It stores NO secret value — only what is expected. Admins manage these.
// A DECLARATION is a single member's fulfilment of one definition: whether they've provided it and,
// when they have, a pointer to the personal Secret that holds the AES-256-GCM value (never plaintext,
// never here). Coverage = how many required definitions a member has fulfilled. workspaceId is a
// buildbase id (no FK, D5); createdByProfileId / profileId are buildbase userIds (no FK).
model UserSecretDefinition {
  id                 String   @id @default(cuid())
  workspaceId        String // buildbase workspace _id; no FK (D5)
  key                String // env-var-like credential key the member must provide, e.g. "GITHUB_TOKEN"
  displayName        String
  description        String? // purpose — shown as the coverage tooltip
  required           Boolean  @default(true)
  createdByProfileId String // buildbase userId of the admin who defined it
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  declarations UserSecretDeclaration[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("user_secret_definitions")
}

model UserSecretDeclaration {
  id              String                      @id @default(cuid())
  definitionId    String
  workspaceId     String // denormalized from the definition for scoped isolation (D5)
  profileId       String // buildbase userId of the member fulfilling it (the subject)
  secretId        String? // the personal Secret holding the encrypted value (null while missing)
  secretVersionId String? // the specific SecretVersion fulfilling it (audit/pinning aid)
  status          UserSecretDeclarationStatus @default(missing)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  definition UserSecretDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  secret     Secret?              @relation(fields: [secretId], references: [id], onDelete: SetNull)

  @@unique([definitionId, profileId])
  @@index([workspaceId])
  @@index([profileId])
  @@index([secretId])
  @@map("user_secret_declarations")
}

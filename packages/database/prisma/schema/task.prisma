// ─── Tasks ────────────────────────────────────────────────────────

enum TaskStatus {
  inbox
  assigned
  in_progress
  review
  done
  blocked
  cancelled // Domain 8 G6.7 — terminal, distinct from done; work abandoned
}

enum Priority {
  low
  medium
  high
  urgent
}

model Task {
  id                 String     @id @default(cuid())
  title              String
  description        String
  status             TaskStatus @default(inbox)
  priority           Priority?
  createdByProfileId String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  dueDate            DateTime?
  deletedAt          DateTime?
  cancelledAt        DateTime? // Domain 8 G6.7 — when the task was cancelled
  tags               String[]   @default([])
  taskNumber         Int        @default(autoincrement())
  parentTaskId       String?
  projectId          String?
  goalId             String? // Epic #11b: the goal this task advances (auto-resolved on create)
  blockedByTaskId    String?
  recurringTaskId    String?

  createdByProfile  Profile?           @relation("TaskCreatedByProfile", fields: [createdByProfileId], references: [id], onDelete: SetNull)
  recurringTask     RecurringTask?     @relation("TaskFromRecurring", fields: [recurringTaskId], references: [id], onDelete: SetNull)
  parentTask        Task?              @relation("TaskParentChild", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks        Task[]             @relation("TaskParentChild")
  blockedByTask     Task?              @relation("TaskBlockedBy", fields: [blockedByTaskId], references: [id], onDelete: SetNull)
  blockingTasks     Task[]             @relation("TaskBlockedBy")
  project           Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  goal              Goal?              @relation("GoalTasks", fields: [goalId], references: [id], onDelete: SetNull) // Epic #11b
  assignees         TaskAssignee[]
  agentsWorkingOn   Agent[]            @relation("AgentCurrentTask")
  messages          Message[]
  activities        Activity[]
  subscriptions     Subscription[]
  workSessions      WorkSession[]
  agentActions      AgentAction[]
  deliverables      Deliverable[]
  queueItems        AgentQueueItem[]
  documents         Document[]
  notifications     Notification[]
  userNotifications UserNotification[]
  approvals         Approval[]         @relation("ApprovalTask")
  costEvents        CostEvent[] // Epic #4
  routineRuns       RoutineRun[]       @relation("TaskFromRoutineRun") // Epic #7
  pipelineCases     PipelineCase[]     @relation("TaskFromPipelineCase")
  caseLinks         CaseTaskLink[]     @relation("CaseTaskLink") // Epic #17
  // Tier C: typed task dependency graph (beyond the single blockedByTaskId).
  relationsFrom     TaskRelation[]     @relation("TaskRelationSource")
  relationsTo       TaskRelation[]     @relation("TaskRelationTarget")
  externalLinks     ExternalLink[]     @relation("TaskExternalLinks")
  attachments       TaskAttachment[]   @relation("TaskAttachments")

  // Epic #8: lease-based atomic checkout + autonomy hardening.
  checkedOutByProfileId  String?
  checkedOutAt           DateTime?
  checkoutLeaseExpiresAt DateTime? // lease TTL; an expired lease is reclaimable
  checkoutToken          String? // opaque fencing token per checkout

  checkedOutBy       Profile?                @relation("TaskCheckedOutBy", fields: [checkedOutByProfileId], references: [id], onDelete: SetNull)
  watchdogs          TaskWatchdog[]
  decompositions     PlanDecomposition[]
  treeHold           TaskTreeHold?
  recoveryActions    TaskRecoveryAction[]
  threadInteractions TaskThreadInteraction[]

  // Domain 9 #11: issue monitor — a one-shot deferred "check back later" wake an agent arms while
  // working (e.g. poll a GitHub check / deploy). When monitorNextCheckAt passes, the reap cron
  // re-dispatches the assignee and clears the schedule; re-arm is explicit. Bounded by maxAttempts.
  monitorNextCheckAt  DateTime?
  monitorNotes        String?
  monitorAttemptCount Int       @default(0)
  monitorMaxAttempts  Int? // null = unbounded

  // Domain 8 §2.1 / G6.4 — task origin & provenance + per-origin idempotency. An autonomy creator
  // (routine / watchdog / plan-decomposition) stamps how a task came to exist; originFingerprint is a
  // stable hash of the origin identity so a duplicate create is a no-op (partial-unique index in the
  // migration). requestDepth bounds recursive autonomy (a task that spawns tasks).
  originKind        String? // routine | watchdog | decomposition | recovery | manual | ...
  originRunId       String? // the run/cycle that produced this task
  originFingerprint String? // stable idempotency key; unique when set
  requestDepth      Int     @default(0)

  @@unique([taskNumber])
  @@index([status])
  @@index([createdAt])
  @@index([parentTaskId])
  @@index([blockedByTaskId])
  @@index([projectId])
  @@index([projectId, status])
  @@index([goalId])
  @@index([checkedOutByProfileId])
  @@index([checkoutLeaseExpiresAt])
  @@index([projectId, createdAt])
  @@index([deletedAt])
  @@index([monitorNextCheckAt])
  @@index([status, deletedAt])
  @@map("tasks")
}

// Tier C: typed task dependency graph. `blocks` is directional (source blocks target); `relates_to`
// and `duplicates` describe non-blocking links. Complements the single blockedByTaskId with a full
// many-to-many graph.
enum TaskRelationType {
  blocks
  relates_to
  duplicates
}

model TaskRelation {
  id                 String           @id @default(cuid())
  sourceTaskId       String
  targetTaskId       String
  type               TaskRelationType @default(relates_to)
  createdByProfileId String?
  createdAt          DateTime         @default(now())

  sourceTask Task @relation("TaskRelationSource", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  targetTask Task @relation("TaskRelationTarget", fields: [targetTaskId], references: [id], onDelete: Cascade)

  @@unique([sourceTaskId, targetTaskId, type])
  @@index([sourceTaskId])
  @@index([targetTaskId])
  @@map("task_relations")
}

// Tier C: external object links — attach a task to an external system (GitHub issue/PR, GitLab, a
// generic URL). Storage/display only; no live sync (that would be an integration = out of scope).
enum ExternalLinkKind {
  github
  gitlab
  url
}

model ExternalLink {
  id                 String           @id @default(cuid())
  taskId             String
  kind               ExternalLinkKind @default(url)
  url                String
  title              String?
  createdByProfileId String?
  createdAt          DateTime         @default(now())

  task Task @relation("TaskExternalLinks", fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("external_links")
}

model TaskAssignee {
  id         String   @id @default(cuid())
  taskId     String
  profileId  String
  assignedAt DateTime @default(now())

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([taskId, profileId])
  @@index([profileId])
  @@map("task_assignees")
}

model TaskTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  subtasks    Json // Array of {title, description, priority?, tags?}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@map("task_templates")
}

model RecurringTask {
  id                 String     @id @default(cuid())
  title              String
  description        String
  status             TaskStatus @default(inbox)
  priority           Priority?
  tags               String[]   @default([])
  recurrenceConfig   Json // { type, interval, daysOfWeek?, dayOfMonth?, time? }
  isActive           Boolean    @default(true)
  timezone           String     @default("UTC")
  nextDueAt          DateTime?
  lastGeneratedAt    DateTime?
  createdByProfileId String?
  projectId          String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  createdByProfile Profile?                @relation("RecurringTaskCreatedByProfile", fields: [createdByProfileId], references: [id], onDelete: SetNull)
  project          Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignees        RecurringTaskAssignee[]
  generatedTasks   Task[]                  @relation("TaskFromRecurring")

  @@index([isActive, nextDueAt])
  @@index([projectId])
  @@map("recurring_tasks")
}

model RecurringTaskAssignee {
  id              String   @id @default(cuid())
  recurringTaskId String
  profileId       String
  assignedAt      DateTime @default(now())

  recurringTask RecurringTask @relation(fields: [recurringTaskId], references: [id], onDelete: Cascade)
  profile       Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([recurringTaskId, profileId])
  @@map("recurring_task_assignees")
}

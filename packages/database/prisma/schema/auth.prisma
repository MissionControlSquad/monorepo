// ─── Admin Auth ───────────────────────────────────────────────────

model AdminUser {
  id                String    @id @default(cuid())
  username          String    @unique
  passwordHash      String
  userId            String?   @unique
  sessionsRevokedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  resetTokensReceived PasswordResetToken[] @relation("ResetTokenTarget")
  resetTokensCreated  PasswordResetToken[] @relation("ResetTokenCreator")

  @@map("admin_users")
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  adminUserId String
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  adminUser AdminUser @relation("ResetTokenTarget", fields: [adminUserId], references: [id], onDelete: Cascade)
  createdBy AdminUser @relation("ResetTokenCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

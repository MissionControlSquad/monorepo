// ─── User & Profile ───────────────────────────────────────────────

enum ProfileKind {
  human
  agent
}

/// Human account — public identity is on Profile
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile           Profile?
  adminUser         AdminUser?
  userNotifications UserNotification[]

  @@map("users")
}

/// Public identity for humans and agents — one unified collection
model Profile {
  id          String      @id @default(cuid())
  kind        ProfileKind
  displayName String
  username    String?     @unique
  avatarUrl   String?
  bio         String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  userId  String? @unique
  agentId String? @unique
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// buildbase (SaaS) user identity this human profile bridges to. Nullable so admin/agent
  /// profiles have none; @unique gives a nullable-unique index (Postgres allows many NULLs) so
  /// each buildbase user maps to exactly one local Profile (the auth-bridge upsert key). See
  /// apps/web/src/server/auth/buildbase-bridge.ts.
  buildbaseUserId String? @unique

  channelMemberships       ChannelMember[]
  channelMessagesFrom      ChannelMessage[]         @relation("ChannelMessageFrom")
  channelMessagesPinned    ChannelMessage[]         @relation("ChannelMessagePinnedBy")
  channelMessageMentions   ChannelMessageMention[]
  channelMessageReactions  ChannelMessageReaction[]
  channelsCreated          Channel[]                @relation("ChannelCreatedByProfile")
  messages                 Message[]
  messageMentions          MessageMention[]
  messageReactions         MessageReaction[]
  taskAssignments          TaskAssignee[]
  createdTasks             Task[]                   @relation("TaskCreatedByProfile")
  deliverables             Deliverable[]
  deliverableVersions      DeliverableVersion[]     @relation("DeliverableVersionEditedByProfile")
  projectMemberships       ProjectMember[]
  activities               Activity[]
  createdRecurringTasks    RecurringTask[]          @relation("RecurringTaskCreatedByProfile")
  recurringTaskAssignments RecurringTaskAssignee[]
  documents                Document[]

  approvalsRequested Approval[]        @relation("ApprovalRequestedBy")
  approvalsDecided   Approval[]        @relation("ApprovalDecidedBy")
  approvalComments   ApprovalComment[] @relation("ApprovalCommentAuthor")

  createdRoutines  Routine[]         @relation("RoutineCreatedByProfile") // Epic #7
  routineRevisions RoutineRevision[] @relation("RoutineRevisionEditedBy")
  claimedCases     PipelineCase[]    @relation("PipelineCaseClaimedBy")

  checkedOutTasks Task[] @relation("TaskCheckedOutBy") // Epic #8

  createdCases Case[] @relation("CaseCreatedByProfile") // Epic #17

  createdSkills Skill[] @relation("SkillCreatedByProfile") // Epic #10

  @@index([kind])
  @@index([username])
  @@map("profiles")
}

// ─── Agent & Agent Activity ───────────────────────────────────────

enum AgentStatus {
  idle
  active
  blocked
}

enum DetailedStatus {
  thinking
  coding
  reviewing
  researching
  deploying
  testing
  writing
  waiting_review
  waiting_input
  waiting_dependency
}

enum AgentLevel {
  intern
  specialist
  lead
}

enum SetupStatus {
  pending_setup
  active
  deactivated
}

enum HostingType {
  selfHosted
  cloudVM
}

enum WorkSessionEventType {
  started
  continued
  paused
  completed
}

enum AgentActionType {
  file_opened
  file_edited
  command_executed
  code_written
  research_done
  comment_posted
  status_update
  thinking
  waiting
  reviewing
  deploying
  testing
  writing_docs
}

enum QueueItemStatus {
  pending
  in_progress
  completed
  blocked
  skipped
}

enum QueueItemPriority {
  low
  medium
  high
  urgent
}

enum QueueItemType {
  task_breakdown
  personal_note
  reminder
  follow_up
  research
  action
}

model Agent {
  id              String          @id @default(cuid())
  name            String
  role            String
  status          AgentStatus     @default(idle)
  detailedStatus  DetailedStatus?
  statusMessage   String?
  currentTaskId   String?
  currentTask     String?
  avatar          String?
  personality     String?
  workspacePath   String?
  identityEmoji   String?
  level           AgentLevel?
  username        String?         @unique
  lastHeartbeat   DateTime?
  setupStatus     SetupStatus     @default(active)
  apiKeyHash      String?         @unique
  apiKeyPrefix    String?
  apiKeyCreatedAt DateTime?
  isOnVacation    Boolean         @default(false)
  templateId      String?
  configVersion   String? // Reported by agent on sync_identity; used for "upgrade available"
  hostingType     HostingType     @default(selfHosted)
  llmModel        String? // Per-agent LLM model override; null = use VM default
  // Tier D: per-agent runtime adapter selection (the control plane dictates how the runner launches
  // this agent). null = use the runner's own configured default.
  runtimeAdapter  String? // adapter key: openclaw|codex|claude|gemini|process|shell|http|<plugin>
  runtimeModel    String? // model override passed to the adapter
  runtimeTemplate String? // command/argv/URL template for process/shell/http adapters
  sandboxProvider String? // Tier D: run this agent's tasks inside a provisioned sandbox (provider key). null = local/runner
  environmentId   String? // Tier D / Phase 3: the Environment (where/how) this agent runs in. null = ad-hoc sandboxProvider
  memoryProvider  String  @default("none") // Tier D memory binding: none | markdown | db
  createdBy       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  currentTaskRef      Task?                @relation("AgentCurrentTask", fields: [currentTaskId], references: [id], onDelete: SetNull)
  documents           Document[]
  notifications       Notification[]
  subscriptions       Subscription[]
  workSessions        WorkSession[]
  statusHistory       StatusHistory[]
  agentActions        AgentAction[]
  queueItems          AgentQueueItem[]
  projectDocsAdded    ProjectDoc[]         @relation("ProjectDocAddedBy")
  projectDocRevisions ProjectDocRevision[] @relation("ProjectDocRevisionEditedBy")
  profile             Profile?

  workspaceId String? // buildbase workspace _id (Epic #1, D5); no FK; backfilled to default workspace

  trustLevel   TrustLevel? // Epic #3: denormalized cache of AgentTrustProfile.trustLevel
  trustProfile AgentTrustProfile?

  costEvents      CostEvent[] // Epic #4
  budgetPolicies  BudgetPolicy[]
  budgetIncidents BudgetIncident[]

  adapterType   String? // Epic #2: FK → AgentAdapter.type; nullable during rollout, backfilled "openclaw-gateway"
  adapterConfig Json? // per-agent config, validated vs AgentAdapter.configSchema
  adapter       AgentAdapter? @relation("AgentAdapterType", fields: [adapterType], references: [type], onDelete: Restrict)

  secretBindings SecretBinding[] // Epic #5
  agentSkills    AgentSkill[] // Epic #10
  goals          Goal[]         @relation("AgentGoals") // Epic #11
  terminalSessions TerminalSession[] @relation("AgentTerminals") // Epic #9
  instructions   AgentInstruction[] @relation("AgentInstructions") // Epic #18

  reportsToAgentId String? // Epic #19: manager edge (org chart); self-FK, SetNull
  reportsTo        Agent?  @relation("AgentOrg", fields: [reportsToAgentId], references: [id], onDelete: SetNull)
  companyId        String? // Domain 14 #10: the AgentCompany this agent belongs to (no FK — soft link)
  reports          Agent[] @relation("AgentOrg")

  capabilityGrants AgentCapabilityGrant[] @relation("AgentGrants") // Epic #21

  @@index([username])
  @@index([workspaceId])
  @@index([adapterType])
  @@index([workspaceId, reportsToAgentId])
  @@map("agents")
}

model StatusHistory {
  id                 String          @id @default(cuid())
  agentId            String
  fromStatus         AgentStatus
  toStatus           AgentStatus
  fromDetailedStatus DetailedStatus?
  toDetailedStatus   DetailedStatus?
  statusMessage      String?
  timestamp          DateTime        @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([agentId, timestamp])
  @@index([timestamp])
  @@map("status_history")
}

model WorkSession {
  id        String               @id @default(cuid())
  taskId    String
  agentId   String
  projectId String?
  startedAt DateTime             @default(now())
  endedAt   DateTime?
  duration  Int? // milliseconds
  eventType WorkSessionEventType

  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent   Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([agentId])
  @@index([taskId, agentId])
  @@index([startedAt])
  @@index([projectId])
  @@map("work_sessions")
}

model AgentAction {
  id          String          @id @default(cuid())
  agentId     String
  taskId      String?
  projectId   String?
  actionType  AgentActionType
  description String
  metadata    Json?
  timestamp   DateTime        @default(now())

  agent   Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([taskId])
  @@index([timestamp])
  @@index([agentId, timestamp])
  @@index([projectId])
  @@map("agent_actions")
}

model AgentQueueItem {
  id                String            @id @default(cuid())
  agentId           String
  title             String
  description       String?
  notes             String?
  status            QueueItemStatus   @default(pending)
  priority          QueueItemPriority @default(medium)
  relatedTaskId     String?
  projectId         String?
  parentQueueItemId String?
  itemType          QueueItemType     @default(action)
  autoGenerated     Boolean           @default(false)
  generatedFrom     String?
  createdAt         DateTime          @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  dueDate           DateTime?
  order             Int               @default(0)

  agent           Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  relatedTask     Task?            @relation(fields: [relatedTaskId], references: [id], onDelete: SetNull)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentQueueItem AgentQueueItem?  @relation("QueueItemParent", fields: [parentQueueItemId], references: [id], onDelete: SetNull)
  childQueueItems AgentQueueItem[] @relation("QueueItemParent")

  @@index([agentId])
  @@index([agentId, status])
  @@index([relatedTaskId])
  @@index([agentId, priority])
  @@index([createdAt])
  @@index([agentId, order])
  @@index([projectId])
  @@map("agent_queue_items")
}

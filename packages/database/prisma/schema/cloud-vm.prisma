// ─── Cloud VMs ────────────────────────────────────────────────────

enum DeploymentStatus {
  provisioning
  waiting_for_ssh
  installing_deps
  installing_openclaw
  configuring
  starting_service
  running
  stopped
  error
  destroying
  destroyed
}

enum DeploymentProvider {
  hetzner
}

model CloudVM {
  id                 String             @id @default(cuid())
  name               String?
  provider           DeploymentProvider @default(hetzner)
  status             DeploymentStatus   @default(provisioning)
  externalServerId   String?
  serverName         String?
  ipv4               String?
  region             String             @default("fsn1")
  serverType         String             @default("cx22")
  webhookSecret      String?
  sshPrivateKey      String?
  sshPublicKey       String?
  hetznerSshKeyId    String?
  setupStep          String?
  setupProgress      Int                @default(0)
  errorMessage       String?
  errorAt            DateTime?
  provisionedAt      DateTime?
  installedAt        DateTime?
  stoppedAt          DateTime?
  destroyedAt        DateTime?
  totalUptimeSeconds Int                @default(0)
  estimatedCostCents Int                @default(0)
  llmConfigured      Boolean            @default(false)
  llmProvider        String?
  llmModel           String?
  gatewayToken       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // ── Live Gateway fields ──────────────────────────────────────────
  vmToken              String?              // bcrypt hash of per-VM token (raw shown once, never stored)
  vmFingerprint        String?   @unique    // Stable ID assigned by MC on first vm.hello
  connectionStatus     VMConnectionStatus   @default(disconnected)
  connectedAt          DateTime?            // Timestamp of most recent successful connection
  lastDisconnectedAt   DateTime?
  pluginVersion        String?              // mc-bridge plugin version reported by plugin
  hostMeta             Json?                // { hostname, platform, arch, openclawVersion? }

  agents            Agent[]
  logs              CloudVMLog[]
  usageRecords      CloudVMUsage[]
  pendingDeliveries PendingTaskDelivery[]

  @@index([status])
  @@index([connectionStatus])
  @@map("cloud_vms")
}

enum VMConnectionStatus {
  connected
  disconnected
}

model PendingTaskDelivery {
  id             String   @id @default(cuid())
  vmId           String
  agentSlug      String
  taskId         String
  message        String   @db.Text
  priority       String   @default("medium")
  idempotencyKey String   @unique           // DB-level uniqueness — prevents double-delivery
  createdAt      DateTime @default(now())
  expiresAt      DateTime                   // 24h TTL — stale tasks not delivered
  delivered      Boolean  @default(false)
  deliveredAt    DateTime?

  cloudVm CloudVM @relation(fields: [vmId], references: [id], onDelete: Cascade)

  @@index([vmId, delivered])
  @@index([vmId, delivered, expiresAt])
  @@map("pending_task_deliveries")
}

model CloudVMLog {
  id        String   @id @default(cuid())
  vmId      String
  message   String
  level     String   @default("info")
  createdAt DateTime @default(now())

  vm CloudVM @relation(fields: [vmId], references: [id], onDelete: Cascade)

  @@index([vmId, createdAt])
  @@map("cloud_vm_logs")
}

model CloudVMUsage {
  id            String   @id @default(cuid())
  vmId          String
  periodStart   DateTime
  periodEnd     DateTime
  uptimeSeconds Int
  costCents     Int

  vm CloudVM @relation(fields: [vmId], references: [id], onDelete: Cascade)

  @@index([vmId])
  @@map("cloud_vm_usage")
}

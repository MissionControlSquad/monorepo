// ─── Documents ────────────────────────────────────────────────────

enum DocumentType {
  deliverable
  research
  protocol
  note
  file
}

model Document {
  id                 String       @id @default(cuid())
  title              String
  content            String
  type               DocumentType
  taskId             String?
  projectId          String?
  createdById        String?
  createdByProfileId String?
  storageKey         String?
  fileName           String?
  mimeType           String?
  fileSize           Int?
  // Domain 8 §2.5 / G5 — cooperative edit lock (advisory). A holder edits without a hard mutex; the lock
  // expires so a crashed editor doesn't strand the doc. Annotation threads re-anchor on each revision.
  lockedByProfileId  String?
  lockedAt           DateTime?
  lockExpiresAt      DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  createdBy                 Agent?                     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdByProfile          Profile?                   @relation(fields: [createdByProfileId], references: [id], onDelete: SetNull)
  task                      Task?                      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project                   Project?                   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messageAttachments        MessageAttachment[]
  channelMessageAttachments ChannelMessageAttachment[]
  caseDocument              CaseDocument?              @relation("CaseDocument") // Epic #17
  revisions                 DocumentRevision[] // Parity §3.12 — generic revision history

  @@index([taskId])
  @@index([type])
  @@index([createdAt])
  @@index([projectId])
  @@map("documents")
}

// Parity §3.12 — generic revision history for the `Document` entity (the analogue of
// ProjectDocRevision / RoutineRevision, which cover only their own doc types). Each revision is a
// content snapshot taken on update, numbered per-document. Author attribution is by plain id (human
// profile or agent) with no FK, mirroring other attribution fields (D5) so this stays additive.
model DocumentRevision {
  id              String   @id @default(cuid())
  documentId      String
  revision        Int // monotonic per-document revision number (1-based)
  title           String
  content         String
  authorProfileId String?
  authorAgentId   String?
  createdAt       DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, revision])
  @@index([documentId, createdAt])
  @@map("document_revisions")
}

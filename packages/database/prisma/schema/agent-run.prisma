// Tier D keystone: a persisted record of ONE agent execution — the run ledger that sandbox runs,
// runner tasks, and (later) adapter runs all write to. Closes the "results returned but never stored"
// gap and is the anchor for run history, retries, per-run cost, and provenance (memory/artifacts).
model AgentRun {
  id                   String    @id @default(cuid())
  workspaceId          String // buildbase workspace id; no FK (D5)
  agentId              String?
  taskId               String?
  // Where/how it ran: "sandbox" | "runner" | "host" | "local". providerKey = sandbox provider (e2b/…) when kind=sandbox.
  kind                 String
  providerKey          String?
  sandboxId            String? // the ephemeral sandbox/host id this run used
  status               String    @default("running") // running | done | failed | timeout | canceled
  // Domain 9 #10 — product silence-watchdog signals. The runner stamps lastOutputAt when output arrives;
  // the watchdog classifies a running run silent past thresholds. watchdogSnoozedUntil suppresses it.
  lastOutputAt         DateTime?
  watchdogSnoozedUntil DateTime?
  exitCode             Int?
  stdout               String?   @db.Text
  stderr               String?   @db.Text
  errorMessage         String?
  costCents            Int?
  // Parity slice (PR #99 tail) — the structured adapter execution result, persisted best-effort when
  // the bound adapter owns an execute()/parseLine (Claude stream-json, Hermes gateway, …). Additive +
  // nullable: a blob-only adapter (or a derivation failure) simply leaves these null. usageTokensIn
  // folds cache-creation prompt tokens into input (mirrors the derivation). exitReason/errorFamily are
  // the machine-readable outcome the control plane can act on without re-parsing stdout.
  usageTokensIn        Int?
  usageTokensOut       Int?
  usageModel           String?
  errorFamily          String? // transient_upstream | provider_quota | model_refusal | auth_required | model_not_found | unknown
  exitReason           String? // completed | error | timeout | max_turns | refusal | auth_required | unknown
  // Domain 8 G2 — untrusted-output review gate. A run by a low-trust/untrusted agent (or one whose
  // trust profile requires it) finalizes `needs_review` with a quarantined sourceTrust marker; a board
  // reviewer promotes it. Standard/trusted output is auto-`approved`. LOW_TRUST_REVIEW-gated.
  reviewState          String? // approved | needs_review | changes_requested (null = not evaluated / feature off)
  sourceTrust          Json? // { preset, disposition, sourceAgentId, sourceRunId, promotedByProfileId }
  reviewedByProfileId  String?
  reviewedAt           DateTime?
  // Domain 9 #6 — scheduled retries + backoff. A transient failure (timeout) sets scheduledRetryAt;
  // the reap cron promotes it to a fresh queued run (retryOfRunId → lineage). retryCount caps retries.
  retryCount           Int       @default(0)
  scheduledRetryAt     DateTime?
  retryReason          String?
  retryOfRunId         String?
  requestedByProfileId String?
  bridgeTokenHash      String? // Plan 6: hash of the run-scoped in-sandbox bridge token (null when inactive)
  startedAt            DateTime  @default(now())
  finishedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Parity §3.12 — task comments this run posted (attribution).
  postedMessages Message[] @relation("MessageCreatedByRun")

  @@index([workspaceId, createdAt])
  @@index([agentId])
  @@index([taskId])
  @@index([bridgeTokenHash])
  @@index([status])
  @@index([scheduledRetryAt])
  @@map("agent_runs")
}

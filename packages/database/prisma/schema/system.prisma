// ─── System ───────────────────────────────────────────────────────

enum FlagManagedBy {
  system
  user
}

/// Singleton — global system settings
model SystemSettings {
  id                   String   @id @default("global")
  shutdownActive       Boolean  @default(false)
  onboardingCompleted  Boolean  @default(false)
  onboardingCategoryId String?
  updatedAt            DateTime @updatedAt

  @@map("system_settings")
}

/// Singleton — stores the activated license
model License {
  id             String   @id @default("active")
  token          String   @db.Text
  plan           String
  org            String
  maxAgents      Int      @default(-1)
  maxProjects    Int      @default(-1)
  maxSeats       Int      @default(-1)
  features       String[] @default([])
  instanceId     String?
  expiresAt      DateTime
  activatedAt    DateTime @default(now())
  lastVerifiedAt DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("licenses")
}

model FeatureFlag {
  id          String        @id @default(cuid())
  key         String        @unique
  enabled     Boolean       @default(false)
  managedBy   FlagManagedBy @default(system)
  description String?
  updatedAt   DateTime      @updatedAt

  @@map("feature_flags")
}

// ─── Agent governance (Epic A.4) ──────────────────────────────────
// Workspace-scoped governance of AI AGENTS (our domain — NOT buildbase workspace settings/branding).
// Enforceable knobs only: each is applied at a real server code path, never a decorative toggle.
model AgentGovernancePolicy {
  id                   String   @id @default(cuid())
  workspaceId          String   @unique // buildbase workspace _id; no FK (D5)
  // When true, newly PROVISIONED agents (team install / import) start pending_setup and cannot be
  // assigned work until an admin activates them — enforced via the assignment-guard.
  requireAgentApproval Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("agent_governance_policies")
}

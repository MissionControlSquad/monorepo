// ─── Projects ─────────────────────────────────────────────────────

enum ProjectStatus {
  active
  archived
}

enum ProjectMemberStatus {
  active
  deactivated
}

enum ProjectDocEditAction {
  created
  updated
  deleted
  archived
}

model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  status         ProjectStatus @default(active)
  shutdownActive Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  members        ProjectMember[]
  tasks          Task[]
  projectDocs    ProjectDoc[]
  activities     Activity[]
  messages       Message[]
  documents      Document[]
  workSessions   WorkSession[]
  agentActions   AgentAction[]
  deliverables   Deliverable[]
  queueItems     AgentQueueItem[]
  channels       Channel[]
  recurringTasks RecurringTask[]

  workspaceId String? // buildbase workspace _id (Epic #1, D5); no FK; backfilled to default workspace

  goalId      String? // Epic #11b: the project's default goal (tasks in it inherit this)
  defaultGoal Goal?   @relation("ProjectDefaultGoal", fields: [goalId], references: [id], onDelete: SetNull)

  // Source configuration (Paperclip Project Workspace parity). Portable metadata; the runtime that
  // actually checks out a repo is separate. sourceType: local_git | non_git | remote_repo |
  // remote_managed. visibility: private | workspace.
  sourceType String? // null = unset (legacy/none)
  repoUrl    String?
  repoRef    String? // branch / tag / ref
  visibility String  @default("private")

  costEvents   CostEvent[] // Epic #4
  ledgerEvents LedgerEvent[] @relation("ProjectLedgerEvents") // Epic #16
  routines     Routine[] // Epic #7
  pipelines    Pipeline[]
  cases        Case[] // Epic #17

  @@index([status])
  @@index([createdAt])
  @@index([workspaceId])
  @@map("projects")
}

model ProjectMember {
  id        String              @id @default(cuid())
  projectId String
  profileId String
  status    ProjectMemberStatus @default(active)
  joinedAt  DateTime            @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([projectId, profileId])
  @@index([profileId])
  @@map("project_members")
}

model ProjectDoc {
  id         String    @id @default(cuid())
  projectId  String
  title      String
  summary    String?
  content    String
  addedById  String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  addedBy   Agent?               @relation("ProjectDocAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  revisions ProjectDocRevision[]
  comments  ProjectDocComment[]

  @@index([projectId])
  @@map("project_docs")
}

// Human review comments/annotations on an agent-authored project doc (Paperclip parity:
// document-annotations, simplified to the monorepo's DeliverableAnnotation shape). quote optionally
// anchors the comment to a snippet; resolved tracks whether the note has been addressed.
model ProjectDocComment {
  id              String   @id @default(cuid())
  docId           String
  body            String
  quote           String?
  resolved        Boolean  @default(false)
  authorProfileId String?
  createdAt       DateTime @default(now())

  doc ProjectDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
  @@map("project_doc_comments")
}

model ProjectDocRevision {
  id         String               @id @default(cuid())
  docId      String
  title      String
  summary    String?
  content    String
  editedById String?
  editAction ProjectDocEditAction
  createdAt  DateTime             @default(now())

  doc      ProjectDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  editedBy Agent?     @relation("ProjectDocRevisionEditedBy", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([docId])
  @@index([docId, createdAt])
  @@map("project_doc_revisions")
}

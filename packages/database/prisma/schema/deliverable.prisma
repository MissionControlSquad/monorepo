// ─── Deliverables ─────────────────────────────────────────────────

enum DeliverableKind {
  markdown
  code
  file
  link
}

model Deliverable {
  id         String          @id @default(cuid())
  taskId     String
  profileId  String
  projectId  String?
  title      String
  kind       DeliverableKind
  content    String?
  language   String?
  storageKey String?         // R2 object key
  fileName   String?
  mimeType   String?
  fileSize   Int?
  url        String?
  version    Int             @default(1)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  task     Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  profile  Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  project  Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  versions    DeliverableVersion[]
  annotations DeliverableAnnotation[]
  votes       DeliverableVote[]

  @@index([taskId])
  @@index([profileId])
  @@index([taskId, profileId])
  @@index([projectId])
  @@map("deliverables")
}

// Tier C: review annotations on a deliverable — a comment, optionally anchored to a quoted snippet
// of the content. Resolvable (like a review thread). Display/review only.
model DeliverableAnnotation {
  id                 String   @id @default(cuid())
  deliverableId      String
  body               String
  quote              String? // the highlighted snippet this comment refers to (optional anchor)
  resolved           Boolean  @default(false)
  createdByProfileId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId, createdAt])
  @@map("deliverable_annotations")
}

// Tier C: lightweight quality/prioritization votes on a deliverable — one up (+1) or down (-1) vote
// per member. Distinct from the formal Approval workflow and from chat reactions. voterId is a
// buildbase userId (no FK, D5).
model DeliverableVote {
  id            String   @id @default(cuid())
  deliverableId String
  voterId       String
  value         Int // +1 or -1
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@unique([deliverableId, voterId])
  @@index([deliverableId])
  @@map("deliverable_votes")
}

model DeliverableVersion {
  id                String          @id @default(cuid())
  deliverableId     String
  version           Int
  title             String
  kind              DeliverableKind
  content           String?
  language          String?
  storageKey        String?
  fileName          String?
  mimeType          String?
  fileSize          Int?
  url               String?
  editedByProfileId String?
  createdAt         DateTime        @default(now())

  deliverable     Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  editedByProfile Profile?    @relation("DeliverableVersionEditedByProfile", fields: [editedByProfileId], references: [id], onDelete: SetNull)

  @@index([deliverableId])
  @@index([deliverableId, version])
  @@map("deliverable_versions")
}

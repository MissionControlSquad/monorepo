// ─── Messages (task-scoped) ───────────────────────────────────────

model Message {
  id            String   @id @default(cuid())
  taskId        String
  fromProfileId String
  content       String
  projectId     String?
  // Parity §3.12 — attribution: the agent run that posted this comment (a run-authored task message),
  // so a comment can be traced back to the run that produced it. Nullable — human/API messages have none.
  createdByRunId String?
  // Work-items §3 Item 2 — rich comment PRESENTATION metadata. A structured JSON payload
  // (`{ kind, ...fields }`, kind ∈ note|status_change|run_summary|deliverable_ref|system) that lets the
  // timeline render a richer card for a system-authored message. Nullable — plain human/agent chat has
  // none and renders as an ordinary bubble (fallback). Additive, never a correctness dependency.
  presentation  Json?
  // Work-items §3 Item 1 — annotation ↔ comment mirror link. When a DocumentAnnotationComment is mirrored
  // into this task Message, this points back at the originating annotation comment (Paperclip
  // issueCommentId equivalent). Nullable + unique: a Message mirrors at most one annotation comment.
  annotationCommentId String? @unique
  createdAt     DateTime @default(now())

  task              Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromProfile       Profile             @relation(fields: [fromProfileId], references: [id], onDelete: Cascade)
  project           Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdByRun      AgentRun?           @relation("MessageCreatedByRun", fields: [createdByRunId], references: [id], onDelete: SetNull)
  annotationComment DocumentAnnotationComment? @relation("AnnotationCommentMirror", fields: [annotationCommentId], references: [id], onDelete: SetNull)
  attachments       MessageAttachment[]
  mentions          MessageMention[]
  reactions         MessageReaction[]
  notifications     Notification[]
  userNotifications UserNotification[]

  @@index([taskId])
  @@index([taskId, createdAt])
  @@index([fromProfileId])
  @@index([createdAt])
  @@index([projectId])
  @@index([createdByRunId])
  @@map("messages")
}

model MessageAttachment {
  id         String @id @default(cuid())
  messageId  String
  documentId String

  message  Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([messageId, documentId])
  @@map("message_attachments")
}

model MessageMention {
  id        String @id @default(cuid())
  messageId String
  profileId String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([messageId, profileId])
  @@map("message_mentions")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  profileId String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([messageId, profileId, emoji])
  @@index([messageId])
  @@index([profileId])
  @@map("message_reactions")
}
